# Dependencies — installed per-machine via npm install (see setup-after-clone.sh)
node_modules/

# Build output — regenerated by `npm run build` (also built inside the Docker image)
client/dist/

# Runtime data written by the server when running locally
server/data/

# SSL certificates — generated by ./container.sh setup-ssl, never committed
certs/

# Python (used from Phase 3 onward)
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/

# OS / editor noise
.DS_Store
*.log
